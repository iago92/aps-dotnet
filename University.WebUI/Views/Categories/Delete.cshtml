@model University.Application.ViewModels.CategoryViewModel

@{
    ViewData["Title"] = "Deletar Categoria";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h1 class="text-danger">@ViewData["Title"]</h1>

            <div class="alert alert-warning">
                <strong>Atenção!</strong> Tem certeza que deseja deletar esta categoria?
            </div>

            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@Model.Name</h5>
                    <p class="card-text">@Model.Description</p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-3">
                <input type="hidden" asp-for="Id" />
                
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Deletar Permanentemente
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </form>
        </div>
    </div>
</div>
