@model University.Application.ViewModels.AlunoViewModel

@{
    ViewData["Title"] = "Detalhes do Aluno";
}

<h1>Detalhes do Aluno</h1>

<div>
    <h4>Aluno</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">Nome</dt>
        <dd class = "col-sm-10">@Model.PrimeiroNome</dd>

        <dt class = "col-sm-2">Sobrenome</dt>
        <dd class = "col-sm-10">@Model.Sobrenome</dd>

        <dt class = "col-sm-2">Email</dt>
        <dd class = "col-sm-10">@Model.Email</dd>

        <dt class = "col-sm-2">Idade</dt>
        <dd class = "col-sm-10">@Model.Idade</dd>
    </dl>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>
