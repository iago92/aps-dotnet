@model IEnumerable<University.Application.ViewModels.ProductViewModel>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Nome</th>
            <th>Categoria</th>
            <th>Preço</th>
            <th>Estoque</th>
            <th>Criado em</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => product.Name)</td>
                <td>@Html.DisplayFor(modelItem => product.CategoryName)</td>
                <td>R$ @Html.DisplayFor(modelItem => product.Price)</td>
                <td>@Html.DisplayFor(modelItem => product.Stock)</td>
                <td>@Html.DisplayFor(modelItem => product.CreatedAt)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-sm btn-info">
                        <i class="bi bi-eye"></i> Ver
                    </a>
                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">
                        <i class="bi bi-trash"></i> Deletar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Nenhum produto encontrado.
    </div>
}
